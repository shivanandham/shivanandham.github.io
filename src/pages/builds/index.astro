---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BuildCard from '../../components/BuildCard.astro';

const builds = (await getCollection('builds', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(builds.map(async (b) => ({ b, Content: (await render(b)).Content })));
---

<Base title="Builds" description="Smaller builds by Shivanandham: an open-source MCP server, a free-tier LLM gateway, an AR video proof of concept, and a fingerprint attendance terminal.">
  <h1>Builds</h1>
  <p class="lede">Open-source tools, proofs of concept and hardware. Each is finished enough to use; the public ones link to source.</p>
  <ul class="cards" style="margin-top:1.5rem">
    {rendered.map(({ b, Content }) => <BuildCard entry={b} Content={Content} />)}
  </ul>
</Base>
