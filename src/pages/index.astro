---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import BuildCard from '../components/BuildCard.astro';
import Timeline from '../components/Timeline.astro';

const featured = (await getCollection('work', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const builds = (await getCollection('builds', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base
  title="Home"
  description="Shivanandham Sankaranarayanan, Senior Software Engineer in Chennai. Python backend and GenAI systems: RAG assistants, agent platforms, MCP servers, recommendation engines, and the backends that hold them up."
>
  <section class="hero">
    <p class="eyebrow">Chennai, India · remote-friendly</p>
    <h1>Shivanandham Sankaranarayanan</h1>
    <p class="role">Senior Software Engineer · Python backend and GenAI systems</p>
    <p class="lede">
      I build the systems behind production AI: retrieval pipelines, agent platforms, MCP servers, recommendation
      engines and the backends under them.
    </p>
    <ul class="links-row" aria-label="Links">
      <li><a class="btn primary" href="https://github.com/shivanandham" target="_blank" rel="me noopener">GitHub</a></li>
      <li><a class="btn" href="https://www.linkedin.com/in/shivanandham" target="_blank" rel="me noopener">LinkedIn</a></li>
      <li><a class="btn" href="/resume.pdf" target="_blank" rel="noopener">Resume (PDF)</a></li>
      <li><a class="btn" href="mailto:rootofshiva@gmail.com">Email</a></li>
    </ul>
  </section>

  <section class="section" aria-labelledby="featured-h">
    <div class="section-head">
      <h2 id="featured-h">Selected work</h2>
      <a class="more" href="/work/">All case studies →</a>
    </div>
    <ul class="cards three">
      {featured.map((entry, i) => <WorkCard entry={entry} wide={i === 0} />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="exp-h">
    <div class="section-head">
      <h2 id="exp-h">Experience</h2>
      <a class="more" href="/resume.pdf" target="_blank" rel="noopener">Resume (PDF) →</a>
    </div>
    <p class="muted small" style="margin-bottom:1rem">Client work delivered as a Francium Tech engineer since January 2021.</p>
    <Timeline />
  </section>

  <section class="section" aria-labelledby="builds-h">
    <div class="section-head">
      <h2 id="builds-h">Smaller builds</h2>
      <a class="more" href="/builds/">All builds →</a>
    </div>
    <ul class="cards three">
      {builds.map((b) => <BuildCard entry={b} />)}
    </ul>
  </section>
</Base>
