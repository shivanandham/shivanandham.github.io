---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DiagramFor from '../../components/DiagramFor.astro';
import Screens from '../../components/Screens.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const groupName = { ai: 'AI systems', product: 'Products I own', platform: 'Backend and platform' }[d.group];
const who = d.client ? `${d.client}${d.via ? `, ${d.via}` : ''}` : '';
const hasGallery = d.screens.length > 0 || d.slots.length > 0;
---

<Base title={d.title} description={d.summary}>
  <article>
    <header class="case-head">
      <p class="eyebrow"><a href={`/work/#${d.group}`}>{groupName}</a></p>
      <h1>{d.title}</h1>
      {who && <p class="client">{who}</p>}
    </header>

    {
      d.hero ? (
        <figure class="case-hero image">
          <div class="frame">
            <img src={d.hero.src} alt={d.hero.alt} width={d.hero.width} height={d.hero.height} decoding="async" />
          </div>
          <figcaption>{d.hero.caption}</figcaption>
        </figure>
      ) : (
        <figure class="case-hero">
          <div class="frame" tabindex="0">
            <DiagramFor name={d.diagram} compact />
          </div>
          <figcaption>Architecture</figcaption>
        </figure>
      )
    }

    <ol class="tldr" aria-label="Summary">
      <li class="tile"><span class="k">Role</span><span class="v">{d.roleShort}</span></li>
      <li class="tile"><span class="k">Period</span><span class="v">{d.period}</span></li>
      <li class="tile"><span class="k">Outcome</span><span class="v">{d.result}</span></li>
    </ol>

    <div class="case-grid">
      <div>
        <section aria-labelledby="built-h">
          <h2 id="built-h">What I built</h2>
          <ul class="bullets">
            {d.built.map((b) => <li>{b}</li>)}
          </ul>
        </section>
        {d.hard && (
          <section aria-labelledby="hard-h">
            <h2 id="hard-h">The hard part</h2>
            <p class="hard">{d.hard}</p>
          </section>
        )}
      </div>
      <aside>
        <section aria-labelledby="stack-h">
          <h2 id="stack-h">Stack</h2>
          <ul class="chips">
            {d.stack.map((s) => <li>{s}</li>)}
          </ul>
        </section>
        <section aria-labelledby="evidence-h">
          <h2 id="evidence-h">Evidence</h2>
          <ul class="evidence">
            {d.links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
              </li>
            ))}
            {d.evidenceNote && <li class="muted">{d.evidenceNote}</li>}
          </ul>
        </section>
      </aside>
    </div>

    {
      hasGallery && (
        <section class="section" aria-labelledby="screens-h">
          <h2 id="screens-h">Screens</h2>
          <p class="muted small">Design renders show demo data.</p>
          <Screens screens={d.screens} slots={d.slots} />
        </section>
      )
    }

    {
      d.hero && (
        <section class="section" aria-labelledby="arch-h">
          <h2 id="arch-h">Architecture</h2>
          <figure class="case-hero">
            <div class="frame" tabindex="0">
              <DiagramFor name={d.diagram} compact idSuffix="-arch" />
            </div>
          </figure>
        </section>
      )
    }

    <details class="more">
      <summary>Full write-up <span class="hint">context, constraints, decisions</span></summary>
      <div class="body prose">
        <Content />
      </div>
    </details>

    <nav class="case-nav" aria-label="Other case studies">
      {prev ? <a href={`/work/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/work/${next.id}/`}>{next.data.title} →</a> : <a href="/work/">All case studies →</a>}
    </nav>
  </article>
</Base>
