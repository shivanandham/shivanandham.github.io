---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const groups = [
  { key: 'ai', title: 'AI systems', intro: 'Retrieval, agents, evaluation and recommendation systems in production.' },
  { key: 'product', title: 'Products I own', intro: 'Built end to end and operated by me, outside client work.' },
  { key: 'platform', title: 'Backend and platform', intro: 'Data platforms and rebuilds where the schema and the migration were the hard part.' },
] as const;
---

<Base title="Work" description="Case studies: AI systems, products I own, and backend and platform work by Shivanandham Sankaranarayanan.">
  <h1>Work</h1>
  <p class="lede">Nine case studies. Client work was delivered as a Francium Tech engineer embedded in the client's team.</p>
  <nav aria-label="Groups">
    <ul class="links-row">
      {groups.map((g) => <li><a class="btn" href={`#${g.key}`}>{g.title}</a></li>)}
    </ul>
  </nav>

  {
    groups.map((g) => {
      const entries = all.filter((e) => e.data.group === g.key);
      if (entries.length === 0) return null;
      return (
        <section class="group" id={g.key} aria-labelledby={`${g.key}-h`}>
          <h2 id={`${g.key}-h`}>{g.title}</h2>
          <p class="intro">{g.intro}</p>
          <ul class="cards three">
            {entries.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </ul>
        </section>
      );
    })
  }
</Base>
