---
/**
 * Flow: an inline-SVG box-and-arrow diagram.
 * Nodes are placed on an explicit viewBox grid; edges are straight lines
 * clipped to the box borders with an arrowhead at the target. All colours
 * come from CSS variables, so the diagram follows light and dark mode.
 */
export interface FlowNode {
  id: string;
  x: number;
  y: number;
  w?: number;
  h?: number;
  /** First line is the title, the rest are smaller subtitle lines. */
  lines: string[];
  kind?: 'box' | 'store' | 'ext' | 'user';
}

export interface FlowEdge {
  from: string;
  to: string;
  label?: string;
  dashed?: boolean;
  /** Both ends get an arrowhead. */
  both?: boolean;
}

export interface FlowGroup {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
}

interface Props {
  title: string;
  caption?: string;
  width: number;
  height: number;
  nodes: FlowNode[];
  edges: FlowEdge[];
  groups?: FlowGroup[];
}

const { title, caption, width, height, nodes, edges, groups = [] } = Astro.props;

const DEFAULT_W = 150;
const DEFAULT_H = 54;
const ARROW = 7;

type Placed = Required<Pick<FlowNode, 'x' | 'y' | 'w' | 'h'>> & FlowNode;
const placed: Record<string, Placed> = {};
for (const n of nodes) {
  placed[n.id] = { ...n, w: n.w ?? DEFAULT_W, h: n.h ?? DEFAULT_H };
}

/** Point where the line from the centre of `n` toward (tx, ty) leaves its border. */
function borderPoint(n: Placed, tx: number, ty: number, pad = 0): [number, number] {
  const cx = n.x + n.w / 2;
  const cy = n.y + n.h / 2;
  const dx = tx - cx;
  const dy = ty - cy;
  if (dx === 0 && dy === 0) return [cx, cy];
  const hw = n.w / 2 + pad;
  const hh = n.h / 2 + pad;
  const tX = dx === 0 ? Infinity : hw / Math.abs(dx);
  const tY = dy === 0 ? Infinity : hh / Math.abs(dy);
  const t = Math.min(tX, tY);
  return [cx + dx * t, cy + dy * t];
}

const lines = edges.map((e) => {
  const a = placed[e.from];
  const b = placed[e.to];
  if (!a || !b) throw new Error(`Flow "${title}": unknown node in edge ${e.from} -> ${e.to}`);
  const acx = a.x + a.w / 2;
  const acy = a.y + a.h / 2;
  const bcx = b.x + b.w / 2;
  const bcy = b.y + b.h / 2;
  const [x1, y1] = borderPoint(a, bcx, bcy, e.both ? ARROW : 0);
  const [x2, y2] = borderPoint(b, acx, acy, ARROW);
  return { ...e, x1, y1, x2, y2, mx: (x1 + x2) / 2, my: (y1 + y2) / 2 };
});

const titleId = `dg-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class="diagram">
  <div class="scroller" tabindex="0" aria-label={`${title} (scrollable diagram)`}>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={titleId} xmlns="http://www.w3.org/2000/svg">
      <title id={titleId}>{title}</title>
      <defs>
        <marker id={`${titleId}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="dg-arrow" d="M 0 0 L 10 5 L 0 10 z"></path>
        </marker>
      </defs>

      {
        groups.map((g) => (
          <g>
            <rect class="dg-group" x={g.x} y={g.y} width={g.w} height={g.h} rx="12" />
            <text class="dg-group-label" x={g.x + 10} y={g.y + 16}>
              {g.label}
            </text>
          </g>
        ))
      }

      {
        lines.map((l) => (
          <g>
            <line
              class={`dg-edge${l.dashed ? ' dashed' : ''}`}
              x1={l.x1}
              y1={l.y1}
              x2={l.x2}
              y2={l.y2}
              marker-end={`url(#${titleId}-arrow)`}
              marker-start={l.both ? `url(#${titleId}-arrow)` : undefined}
            />
            {l.label && (
              <text class="dg-edge-label" x={l.mx} y={l.my - 5} text-anchor="middle">
                {l.label}
              </text>
            )}
          </g>
        ))
      }

      {
        Object.values(placed).map((n) => {
          const kind = n.kind ?? 'box';
          const cls = kind === 'store' ? 'dg-store' : kind === 'ext' ? 'dg-ext' : kind === 'user' ? 'dg-user' : 'dg-box';
          const rx = kind === 'user' ? n.h / 2 : kind === 'store' ? 14 : 8;
          const cx = n.x + n.w / 2;
          const total = n.lines.length;
          const lineH = 15;
          const startY = n.y + n.h / 2 - ((total - 1) * lineH) / 2 + 4.5;
          return (
            <g>
              <rect class={cls} x={n.x} y={n.y} width={n.w} height={n.h} rx={rx} />
              {n.lines.map((t, i) => (
                <text class={i === 0 ? 'dg-title' : 'dg-sub'} x={cx} y={startY + i * lineH} text-anchor="middle">
                  {t}
                </text>
              ))}
            </g>
          );
        })
      }
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
